# ========================================
# 论文查重管理系统 - 生产环境变量模板
#
# 用法: cp .env.example .env  然后把所有 <CHANGE_ME> 换成真实值
# 生成强口令: openssl rand -hex 16   （纯十六进制，避免 JDBC/URL 里的转义问题）
#
# .env 已被 .gitignore 忽略，切勿提交。
# ========================================

# --- MySQL 数据库 ---
# 主机名用 docker 网络别名，不是容器名
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=<CHANGE_ME_MYSQL_PASSWORD>
# 库名：生产指向既有库 check-repeat-system（代码内默认值为 check-repeat-service）
MYSQL_DATABASE=check-repeat-system

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>

# --- JWT ---
# 生成方法: openssl rand -base64 32
JWT_SECRET_KEY=<CHANGE_ME_JWT_SECRET_32_CHARS>

# --- MinIO 对象存储 ---
# 后端（SDK）连 MinIO 用：容器网络内的地址别名
MINIO_ENDPOINT=http://minio:9000

# 拼给浏览器用的地址（头像的 <img src>、论文正文路径）。
# ⚠️ 不能留空、也不能填容器别名：这个值会原样存进数据库再交给浏览器，
#    填 http://minio:9000 的话浏览器解析不了该主机名，头像一律裂图。
# 线上走网关反代，前缀必须与 /opt/check-repeat/nginx/conf/nginx.conf 中的
# location /minio/ 完全一致；留空则回退成 MINIO_ENDPOINT（即上面的裂图行为）。
MINIO_PUBLIC_ENDPOINT=https://check-repeat-system.xyz/minio

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=<CHANGE_ME_MINIO_PASSWORD>

# --- 文件存储类型: LOCAL 或 OSS ---
STORAGE_TYPE=LOCAL

# --- 阿里云 OSS（STORAGE_TYPE=OSS 时才需要）---
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_ACCESS_PREFIX=

# --- 邮件服务（QQ邮箱）---
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=<CHANGE_ME_QQ_EMAIL>
MAIL_PASSWORD=<CHANGE_ME_QQ_SMTP_AUTH_CODE>

# --- 第三方查重（可选，默认关闭）---
THIRD_PARTY_API_KEY=

# --- 文件在线预览 ---
# 用 docker 网络别名 kkfileview，端口取 kkFileView 容器实际监听端口
KKFILEVIEW_BASE_URL=http://kkfileview:8012